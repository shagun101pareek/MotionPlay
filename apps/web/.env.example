# Optional. When unset, the site uses the browser hostname and port 4000.
# Production example: https://play.example.com
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PORT=4000

# Public origin encoded in the QR code. Required in production.
# Local example, if you do not want automatic LAN detection:
# NEXT_PUBLIC_PUBLIC_ORIGIN=http://192.168.1.20:3000
NEXT_PUBLIC_PUBLIC_ORIGIN=
